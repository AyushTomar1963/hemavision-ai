# Copy to .env for local development. All keys accept the HEMAVISION_ prefix.

# Verbosity
HEMAVISION_LOG_LEVEL=INFO

# Uploads
HEMAVISION_MAX_UPLOAD_BYTES=12582912

# ConvNeXt forward pass (adds latency + memory)
HEMAVISION_RUN_CONVNEXT=false

# Comma-separated allowed CORS origins for the frontend
HEMAVISION_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Auth — set to true to require a Bearer token on /analyze
HEMAVISION_AUTH_REQUIRED=false
# Change this in any deployment
HEMAVISION_JWT_SECRET=change-me-in-production-please
HEMAVISION_JWT_ALGORITHM=HS256
HEMAVISION_JWT_EXPIRE_MINUTES=1440

# Seeded demo user (created on first startup)
HEMAVISION_DEMO_USER_EMAIL=demo@hemavision.ai
HEMAVISION_DEMO_USER_PASSWORD=demo1234

# Sqlite location for the user store
HEMAVISION_DB_PATH=hemavision.db

# Rate limits (slowapi syntax)
HEMAVISION_RATE_LIMIT_ANALYZE=30/minute
HEMAVISION_RATE_LIMIT_AUTH=10/minute
